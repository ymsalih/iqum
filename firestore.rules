rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function activeAccount() { return request.auth != null && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid)); }
    match /users/{uid} {
      allow read: if activeAccount() && request.auth.uid == uid;
      allow write: if false;
    }
    match /matches/{id} {
      allow read: if activeAccount() && request.auth.uid in resource.data.members;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

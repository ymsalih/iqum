rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in, not being deleted, and (for e-mail accounts) address confirmed.
    function verified() { return request.auth.token.firebase.sign_in_provider != 'password' || request.auth.token.email_verified == true; }
    function activeAccount() { return request.auth != null && verified() && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid)); }
    match /users/{uid} {
      allow read: if activeAccount() && request.auth.uid == uid;
      allow write: if false;
    }
    match /matches/{id} {
      allow read: if activeAccount() && request.auth.uid in resource.data.members;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

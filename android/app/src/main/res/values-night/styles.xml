<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window while the process starts in dark mode; removed on Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI: the app's porcelain, so no white or black flash. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/iqum_ivory</item>
    </style>
</resources>
